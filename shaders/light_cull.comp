#version 450
#extension GL_GOOGLE_include_directive : require

// Assigns every point light to the clusters its volume reaches.
//
// One invocation per cluster: it builds its own view-space bounding box from
// the inverse projection, walks the scene's lights, and writes the indices of
// those that touch it. The fragment shader then loops that list instead of
// every light in the scene, which is the whole point - shading cost stops
// scaling with how many lights exist and starts scaling with how many
// actually overlap the pixel.
//
// The geometry here mirrors src/render/ClusterGrid.cpp exactly. That file is
// the specification and is unit-tested on the CPU; this is the implementation.
// If the two ever disagree, fragments look up lights from a cell they are not
// in - which reads as lighting that pops as the camera moves rather than as
// anything obviously broken.

layout(local_size_x = 64) in;

#include "global_ubo.glsl"

layout(std430, set = 0, binding = 6) readonly buffer LightBuffer {
    PointLight lights[];
} lightBuffer;

// One entry per cluster: how many lights reached it, then their indices. A
// fixed stride rather than a packed list with an offset table, because a
// fixed stride is addressable without a second pass to compute the offsets.
layout(std430, set = 0, binding = 7) writeonly buffer ClusterBuffer {
    uint data[];
} clusterBuffer;

// See ClusterGrid.cpp: scaling by |z| rather than z keeps this correct
// whichever way the projection points. This engine's camera looks down +Z.
vec3 pointAtDepth(vec3 direction, float depth) {
    if (abs(direction.z) < 1e-9) {
        return direction;
    }
    return direction * (depth / abs(direction.z));
}

vec3 unproject(float ndcX, float ndcY) {
    vec4 view = ubo.inverseProjection * vec4(ndcX, ndcY, 1.0, 1.0);
    return view.xyz / view.w;
}

float sliceDepth(uint slice) {
    float ratio = ubo.clusterParams.w / ubo.clusterParams.z;
    float t = float(slice) / float(ubo.clusterGrid.z);
    return ubo.clusterParams.z * pow(ratio, t);
}

void main() {
    uint cluster = gl_GlobalInvocationID.x;
    uint clusterCount = ubo.clusterGrid.x * ubo.clusterGrid.y * ubo.clusterGrid.z;
    // The dispatch rounds up to whole workgroups, so the last one runs
    // invocations past the end of the grid.
    if (cluster >= clusterCount) {
        return;
    }

    uint ix = cluster % ubo.clusterGrid.x;
    uint iy = (cluster / ubo.clusterGrid.x) % ubo.clusterGrid.y;
    uint iz = cluster / (ubo.clusterGrid.x * ubo.clusterGrid.y);

    float minU = float(ix) / float(ubo.clusterGrid.x);
    float maxU = float(ix + 1u) / float(ubo.clusterGrid.x);
    float minV = float(iy) / float(ubo.clusterGrid.y);
    float maxV = float(iy + 1u) / float(ubo.clusterGrid.y);

    float nearDepth = sliceDepth(iz);
    float farDepth = sliceDepth(iz + 1u);

    // All four corners, because an off-centre projection has no symmetry to
    // exploit and the tile's own corners are what bound it regardless.
    vec2 corners[4] = vec2[4](
        vec2(minU, minV), vec2(maxU, minV), vec2(minU, maxV), vec2(maxU, maxV));

    vec3 boundsMin = vec3(1e30);
    vec3 boundsMax = vec3(-1e30);
    for (int i = 0; i < 4; i++) {
        vec3 ray = unproject(corners[i].x * 2.0 - 1.0, corners[i].y * 2.0 - 1.0);
        vec3 nearPoint = pointAtDepth(ray, nearDepth);
        vec3 farPoint = pointAtDepth(ray, farDepth);
        boundsMin = min(boundsMin, min(nearPoint, farPoint));
        boundsMax = max(boundsMax, max(nearPoint, farPoint));
    }

    uint stride = ubo.clusterGrid.w + 1u;
    uint base = cluster * stride;

    uint found = 0u;
    for (int i = 0; i < ubo.numLights && found < ubo.clusterGrid.w; i++) {
        vec3 centre = (ubo.view * vec4(lightBuffer.lights[i].position.xyz, 1.0)).xyz;
        float radius = lightBuffer.lights[i].position.w;

        // Closest point in the box to the light, compared against its reach.
        vec3 closest = clamp(centre, boundsMin, boundsMax);
        vec3 offset = centre - closest;
        if (dot(offset, offset) <= radius * radius) {
            clusterBuffer.data[base + 1u + found] = uint(i);
            found++;
        }
    }

    // Written last and unconditionally: the count is what the fragment shader
    // trusts, so it must never be left over from the previous frame. That is
    // also why nothing here needs the buffer cleared first.
    clusterBuffer.data[base] = found;
}
